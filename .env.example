# Qual LLM usar por padrão: "anthropic" ou "openai"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# OpenAI (opcional — só necessário se LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Fonte de métricas — o simulador local usa este valor por padrão
PROMETHEUS_URL=http://127.0.0.1:9090

# Log de deploys simulado (gerado por simulator/seed_deploys.py)
DEPLOYS_FILE=simulator/deploys.json
